# Scidb engines file
# Version: 1.0 BETA
# Syntax: Tcl language format

set ::engine::Engines {
	{
		Name Stockfish
		Identifier "Stockfish 19"
		Author "the Stockfish developers (see AUTHORS file)"
		Url https://stockfishchess.org
		Command stockfish-scidb
		Protocol UCI
		Variants {standard chess960}
		Features:UCI {
			analyze true
			multiPV 256
			ponder true
			hashSize {4 33554432}
			threads {1 1024}
			clearHash true
			limitStrength {1320 3190}
			skillLevel {0 20}
		}
		Profiles:UCI {
			Default {
				{{Debug Log File} string <empty> <empty> {} {}}
				{NumaPolicy string auto auto {} {}}
				{Threads spin 1 1 1 1024}
				{Hash spin 16 16 1 33554432}
				{{Clear Hash} button {} {} {} {}}
				{{Skill Level} spin 20 20 0 20}
				{{Move Overhead} spin 10 10 0 5000}
				{nodestime spin 0 0 0 10000}
				{SyzygyPath path <empty> <empty> {} {}}
				{SyzygyProbeDepth spin 1 1 1 100}
				{Syzygy50MoveRule check true true {} {}}
				{SyzygyProbeLimit spin 7 7 0 7}
			}
		}
	}
	{
		Name Sjeng
		Identifier "Sjeng 11.2 scidb"
		Author "Gian-Carlo Pascutto"
		Url http://sjeng.org/index.html
		Elo 2450
		Command /usr/local/games/sjeng-scidb
		Protocol WB
		Variants {standard bughouse crazyhouse suicide giveaway losers}
		Features:WB {analyze true hashSize {}}
		ProfileType Script
		Profiles:WB { Default { "kingsafety 1.0 # 0.0<->2.5 (zhouse only)" } }
	}
}
