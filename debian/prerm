#!/bin/sh
set -e
#DEBHELPER#
[ "$1" = remove ] || [ "$1" = upgrade ] || exit 0
xdgdir=/usr/share/chesswiz/freedesktop.org
if [ -f /usr/local/share/chesswiz/freedesktop.org/Makefile ]; then
	xdgdir=/usr/local/share/chesswiz/freedesktop.org
fi
if [ -d $xdgdir ]; then
	cd $xdgdir
	make -f Makefile uninstall-mime
	make -f Makefile uninstall-desktop-menu
fi
