# Every id generated by toolbar::RegistryCommand must retain its native
# translated label in the registry and in the actual Ask results.
package require tcltest 2.5
source [file join [file dirname [info script]] app_actions_support.tcl]
namespace eval ::scidb::test::toolbarTranslations {
    proc nop {args} {return 0}
    proc setup {} {
        ::scidb::test::actions::ready
        ::knowledge::Ensure
        set pgn [::scidb::test::actions::fixture]
        set base [file rootname $pgn].sci
        ::scidb::db::open $pgn [namespace current]::nop {} [namespace current]::nop {}
        ::scidb::db::new $base Normal [::application::database::lookupType Unspecific]
        ::scidb::db::attach $base $base
        ::scidb::db::copy $pgn $base {} [namespace current]::nop {} [namespace current]::nop {}
        ::scidb::db::save $base [namespace current]::nop {}
        ::scidb::db::close $base
        ::scidb::db::close $pgn
        ::action::run open_database [dict create path $base]
        ::action::run open_game {number 1}
        update
        return $base
    }
    proc nativeLabels {} {
        set labels {}
        foreach key [array names ::toolbar::Specs children:*] {
            set toolbar [string range $key 9 end]
            foreach w $::toolbar::Specs($key) {
                if {![winfo exists $w]} { continue }
                # Disabled native controls may clear -command; toolbar metadata
                # retains the command used when the widget is enabled.
                set command ""
                catch {set command [$w cget -command]}
                if {![string match {::action::run toolbar.*} $command]} {
                    catch {set command $::toolbar::Specs(command:$w:$toolbar)}
                }
                if {![string match {::action::run toolbar.*} $command]} { continue }
                set label ""
                set var $::toolbar::Specs(tooltipvar:$w:$toolbar)
                if {$var ne "" && [info exists $var]} {
                    set label [set $var]
                } else {
                    set label $::toolbar::Specs(tooltip:$w:$toolbar)
                }
                if {$label eq ""} { catch {set label [$w cget -text]} }
                dict set labels [lindex $command 1] [string trim [string map {& {}} $label]]
            }
        }
        return $labels
    }
    proc check {lang} {
        ::menu::SwitchLanguage $lang
        update
        ::application::board::UpdateSaveButton
        update
        set native [nativeLabels]
        set rows [::action::labels asklist]
        set ids {}
        foreach id [::action::list] {
            if {[string match toolbar.* $id]
                && [lindex [dict get [::action::get $id] handler] 0] eq "::toolbar::InvokeCommand"} {
                lappend ids $id
            }
        }
        set ids [lsort $ids]
        set errors {}
        if {$::mc::langID ne $lang} {lappend errors [list wrong-language $::mc::langID $lang]}
        if {$lang eq "de" && [dict get $native toolbar.board_layout.1] ne "Zugvorschlag anzeigen"} {
            lappend errors german-suggested-move-not-translated
        }
        # Also register a real native button while this language is active.
        # This catches registration-time regressions that a later refresh could mask.
        set parent [winfo parent $::application::board::Vars(game:save)]
        set button [::toolbar::add $parent button -command {return} \
            -tooltipvar ::board::options::mc::ShowSuggestedMove]
        set freshId [lindex [$button cget -command] 1]
        if {[dict get [::action::get $freshId] label] ne $::board::options::mc::ShowSuggestedMove} {
            lappend errors [list $freshId registration-label-not-translated]
        }
        ::toolbar::forget $button
        dict unset ::action::Registry $freshId
        foreach id $ids {
            if {![dict exists $native $id]} {
                lappend errors [list $id missing-native-widget]
                continue
            }
            set expected [dict get $native $id]
            if {$expected eq ""} {
                lappend errors [list $id empty-native-label]
                continue
            }
            set registry [dict get [::action::get $id] label]
            set row [lsearch -inline -index 0 $rows $id]
            set entry [::application::ask::Entry]
            $entry delete 0 end
            $entry insert 0 $expected
            focus -force $entry
            event generate $entry <KeyRelease> -keysym a
            update
            set ask [lsearch -inline -index 0 $::application::ask::Priv(rows) $id]
            set index [lsearch -index 0 $::application::ask::Priv(rows) $id]
            set list $::application::ask::Priv(list).list
            set rendered ""
            if {$index >= 0 && [winfo viewable $list]} {
                set rendered [string range [string trimleft [$list get $index]] \
                    0 [expr {[string length $expected] - 1}]]
            }
            if {$registry ne $expected || [lindex $row 1] ne $expected
                || [lindex $ask 1] ne $expected || $rendered ne $expected} {
                lappend errors [list $id native $expected registry $registry labels $row ask $ask rendered $rendered]
            }
        }
        puts "TOOLBAR_LABELS $lang ids=[llength $ids] native=[dict size $native] errors=$errors"
        if {[llength $ids] < 14} { lappend errors short-toolbar-inventory }
        return $errors
    }
}
set toolbarTranslationBase [::scidb::test::toolbarTranslations::setup]
foreach lang {de es} {
    tcltest::test toolbar-translations-$lang {every native toolbar label agrees with registry and actual Ask rows} -setup {
        set saved $::mc::langID
    } -body [list ::scidb::test::toolbarTranslations::check $lang] -cleanup {
        ::application::ask::HideList
        ::menu::SwitchLanguage $saved
    } -result {}
}

::game::release [::scidb::game::current]
::application::database::closeBase .application $toolbarTranslationBase
tcltest::cleanupTests
