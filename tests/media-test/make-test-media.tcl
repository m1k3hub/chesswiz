#!/usr/bin/env tclsh
# Compute game fingerprints and create a .scm companion manifest
# with sample media files. No tkscidb dependency needed.
#
# Usage: tclsh8.6 make-test-media.tcl <output-rootname>

if {[llength $argv] < 1} {
    puts stderr "usage: $argv0 <output-rootname>"
    exit 1
}

set outRoot [lindex $argv 0]

# --- FNV-1a-64 (matches db::scm::MediaTable::fingerprint) ---

proc normalize {s} {
    set s [string trim $s]
    return [string tolower $s]
}

proc fnv1a64 {h s} {
    for {set i 0} {$i < [string length $s]} {incr i} {
        scan [string index $s $i] %c c
        set h [expr {($h ^ $c) & 0xFFFFFFFFFFFFFFFF}]
        set h [expr {($h * 0x100000001b3) & 0xFFFFFFFFFFFFFFFF}]
    }
    return $h
}

proc fingerprint {white black event date round result} {
    set h 0xcbf29ce484222325
    set h [fnv1a64 $h [normalize $white]]
    set h [fnv1a64 $h "|"]
    set h [fnv1a64 $h [normalize $black]]
    set h [fnv1a64 $h "|"]
    set h [fnv1a64 $h [normalize $event]]
    set h [fnv1a64 $h "|"]
    set h [fnv1a64 $h [normalize $date]]
    set h [fnv1a64 $h "|"]
    set h [fnv1a64 $h "${round}|${result}"]
    return [format "%016llx" $h]
}

# --- The 3 test games (must match test-games.pgn exactly) ---

set games {
    {"Topalov,J" "Anand,V" "Bilbao Masters Final" "2008.09.20" 1 "1/2-1/2"}
    {"Carlsen,Magnus" "Kramnik,Vladimir" "Linares" "2009.02.20" 1 "1-0"}
    {"Carlsen,Magnus" "Kramnik,Vladimir" "London Chess Classic" "2012.12.08" 1 "1/2-1/2"}
}

# --- Create media directory with sample files ---

set mediaDir ${outRoot}.media
file mkdir $mediaDir/images $mediaDir/audio $mediaDir/video

# 1x1 pixel PNG (valid, viewable)
set pngData [binary decode base64 \
    "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mNk+M9QDwADhgGAWjR9awAAAABJRU5ErkJggg=="]

foreach name {bilbao2008.jpg linares2009.jpg london2012.jpg} {
    set fd [open [file join $mediaDir images $name] wb]
    puts -nonewline $fd $pngData
    close $fd
}

# Dummy audio (text placeholder)
set fd [open [file join $mediaDir audio interview.mp3] w]
puts $fd "dummy audio file"
close $fd

# Dummy video (text placeholder)
set fd [open [file join $mediaDir video analysis.mp4] w]
puts $fd "dummy video file"
close $fd

# --- Write the .scm manifest ---

set scmFile ${outRoot}.scm
set fd [open $scmFile w]

puts $fd {# Test media manifest for scidb .scm companion}
puts $fd {# Generated by make-test-media.tcl}
puts $fd ""
puts $fd {[Database "Test Media Database"]}
puts $fd {[MediaDir "test-media.media"]}
puts $fd {[Encoding "utf-8"]}
puts $fd ""

# Media library
puts $fd {[Media "M01"]}
puts $fd "Type: picture"
puts $fd "Path: images/bilbao2008.jpg"
puts $fd {Title: "Bilbao 2008: Topalov-Anand"}
puts $fd ""

puts $fd {[Media "M02"]}
puts $fd "Type: audio"
puts $fd "Path: audio/interview.mp3"
puts $fd {Title: "Post-game interview"}
puts $fd ""

puts $fd {[Media "M03"]}
puts $fd "Type: picture"
puts $fd "Path: images/linares2009.jpg"
puts $fd {Title: "Linares 2009: Carlsen-Kramnik"}
puts $fd ""

puts $fd {[Media "M04"]}
puts $fd "Type: video"
puts $fd "Path: video/analysis.mp4"
puts $fd {Title: "Game analysis video"}
puts $fd ""

puts $fd {[Media "M05"]}
puts $fd "Type: picture"
puts $fd "Path: images/london2012.jpg"
puts $fd {Title: "London 2012: Carlsen-Kramnik"}
puts $fd ""

# Game linkages
set i 0
foreach game $games {
    lassign $game white black event date round result
    set fp [fingerprint $white $black $event $date $round $result]
    puts "Game $i: $white vs $black"
    puts "  Event: $event  Date: $date  Round: $round  Result: $result"
    puts "  Fingerprint: $fp"

    puts $fd "\[Game \"${fp}\"\]"
    switch -- $i {
        0 { puts $fd "Media: M01, M02" }
        1 { puts $fd "Media: M03, M04" }
        2 { puts $fd "Media: M05" }
    }
    puts $fd ""
    incr i
}

close $fd

puts ""
puts "=== Created files ==="
puts "  Manifest:  $scmFile"
puts "  Media dir: $mediaDir"
puts ""
puts "=== Test instructions ==="
puts "1. Import test-games.pgn into scidb (creates a .sci database)"
puts "2. Name the database '$outRoot' so the .scm companion is found"
puts "3. Open the database in scidb"
puts "4. Select a game — the Media tab should show the linked entries"
puts "5. Double-click a media entry to open it"