# Shortcut overrides saved before the menu redesign (the format written by
# ::application::keyEditor::WriteOptions). The action ids are the 28 frozen
# key-editor ids; a restart after the redesign must apply these keys.
array set ::application::keyEditor::Options {
	shortcut:keys,game-save Control-g
	shortcut:keys,app-quit Control-j
	shortcut:keys,game-next F9
	shortcut:keys,game-new Control-Alt-g
}
