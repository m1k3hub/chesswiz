{"id": "m2-download", "area": "media", "request": "Get games from the internet.", "predicate": "ev_opened download", "actions": ["menu.tools.download", "run_action", "find_capability"], "gold": "gold_run menu.tools.download"}
{"id": "m2-importdlg", "area": "media", "request": "Open the game import window.", "predicate": "ev_opened import", "actions": ["menu.tools.import_games", "menu.file.import.pgn", "run_action", "find_capability"], "gold": "gold_run menu.tools.import_games"}
{"id": "l2-dbtab", "area": "layout", "request": "Show me the database view.", "predicate": "expr {[ev_tab] eq {database}}", "actions": ["switch_tab", "run_action", "find_capability"], "gold": "gold_call switch_tab {tab database}"}
{"id": "l2-board", "area": "layout", "request": "Show the board tab.", "predicate": "expr {[ev_tab] eq {board}}", "actions": ["switch_tab", "run_action", "find_capability"], "gold": "gold_call switch_tab {tab board}", "setup": "::application::switchTab database"}
{"id": "l2-full", "area": "layout", "request": "Fullscreen, please.", "predicate": "ev_fullscreen", "actions": ["app-fullscreen", "run_action", "find_capability"], "gold": "gold_run app-fullscreen"}
{"id": "l2-unfull", "area": "layout", "request": "exit fullscreen", "predicate": "expr {![ev_fullscreen]}", "actions": ["app-fullscreen", "run_action", "find_capability"], "gold": "gold_run app-fullscreen", "setup": "::menu::setFullscreen 1", "loose": 1}
{"id": "l2-font", "area": "layout", "request": "biger font", "predicate": "expr {[ev_fontsize] > $::EV(f)}", "actions": ["menu.view.font_inc", "run_action", "find_capability"], "gold": "gold_run menu.view.font_inc", "setup": "set ::EV(f) [ev_fontsize]", "loose": 1}
{"id": "l2-fontdec", "area": "layout", "request": "Make the text smaller.", "predicate": "expr {[ev_fontsize] < $::EV(f)}", "actions": ["menu.view.font_dec", "run_action", "find_capability"], "gold": "gold_run menu.view.font_dec", "setup": "::font::changeFontSize +1; update; set ::EV(f) [ev_fontsize]"}
{"id": "l2-keys", "area": "layout", "request": "Open the keyboard preferences.", "predicate": "ev_opened key", "actions": ["menu.edit.keyboard", "run_action", "find_capability"], "gold": "gold_run menu.edit.keyboard"}
{"id": "l2-max", "area": "layout", "request": "Make the board pane fill the whole window.", "predicate": "ev_zoomed board", "actions": ["pane", "run_action", "find_capability"], "gold": "gold_call pane {action maximise pane board}"}
{"id": "l2-restore", "area": "layout", "request": "Restore the normal layout.", "predicate": "expr {![ev_zoomed board]}", "actions": ["pane", "run_action", "find_capability"], "gold": "gold_call pane {action restore pane board}", "setup": "::application::assistant::RunTool pane {action maximise pane board}"}
{"id": "l2-float-max", "area": "layout", "request": "Undock the tree and maximise the board.", "predicate": "expr {[ev_floating tree] && [ev_zoomed board]}", "actions": ["pane", "menu.view.panes.tree", "run_action", "find_capability"], "gold": "gold_call pane {action undock pane tree}; gold_call pane {action maximise pane board}", "setup": "ev_pane_show tree", "multi": 1}
{"id": "l2-tab-clear", "area": "layout", "request": "Switch to the database tab and clear the filter.", "predicate": "expr {[ev_tab] eq {database} && [ev_search_count] == [ev_total_games]}", "actions": ["switch_tab", "clear_search", "run_action", "find_capability"], "gold": "gold_call switch_tab {tab database}; gold_call clear_search", "setup": "gold_call search_games {player Ashraf}; gold_call show_search", "multi": 1}
{"id": "x2-print", "area": "export", "request": "Print the current game.", "predicate": "ev_printed", "actions": ["print", "run_action", "find_capability"], "gold": "gold_call print", "setup": "set ::RequestEval::PrintBefore [glob -nocomplain -directory [::print::TempDir] *.pdf]"}
{"id": "x2-print-loose", "area": "export", "request": "paper copy of this game pls", "predicate": "ev_printed", "actions": ["print", "run_action", "find_capability"], "gold": "gold_call print", "setup": "set ::RequestEval::PrintBefore [glob -nocomplain -directory [::print::TempDir] *.pdf]", "loose": 1}
{"id": "x2-load-print", "area": "export", "request": "Load game 7 and print it.", "predicate": "expr {[ev_gameno] == 7 && [ev_printed]}", "actions": ["open_game", "print", "run_action", "find_capability"], "gold": "gold_call open_game {number 7}; gold_call print", "setup": "set ::RequestEval::PrintBefore [glob -nocomplain -directory [::print::TempDir] *.pdf]", "multi": 1}
