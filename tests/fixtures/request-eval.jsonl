{"id": "d2-open", "area": "databases", "request": "Open the database file @CLUB@.", "predicate": "ev_db_is @CLUB@", "actions": ["open_database", "menu.file.open", "run_action", "find_capability"], "gold": "gold_call open_database [list path @CLUB@]"}
