{"id": "dbh-open", "area": "databases", "request": "Open my club database, it's the file @CLUB@.", "predicate": "ev_db_is @CLUB@", "actions": ["open_database", "menu.file.open", "run_action"], "gold": "gold_call open_database [list path @CLUB@]"}
{"id": "dbh-close", "area": "databases", "request": "Close this database, I'm done with it.", "predicate": "expr {![ev_open @CLUB@] && [ev_open @MAIN@]}", "actions": ["menu.file.close", "run_action"], "gold": "gold_run menu.file.close", "setup": "::application::database::openBase .application @CLUB@ yes -encoding $::encoding::autoEncoding -switchToBase 1"}
{"id": "dbh-switch", "area": "databases", "request": "go back to the main database", "predicate": "ev_db_is @MAIN@", "actions": ["open_database", "menu.file.open", "switch_tab", "run_action"], "gold": "gold_call open_database [list path @MAIN@]", "setup": "::application::database::openBase .application @CLUB@ yes -encoding $::encoding::autoEncoding -switchToBase 1", "loose": 1}
{"id": "dbh-props", "area": "databases", "request": "Show the properties of the current database.", "predicate": "ev_opened prop", "actions": ["menu.db.properties", "database_properties", "open_view", "run_action"], "gold": "gold_run menu.db.properties"}
{"id": "dbh-discover", "area": "databases", "request": "look for chess databses on my computer", "predicate": "ev_opened discover", "actions": ["discover_databases", "menu.db.discover", "run_action"], "gold": "gold_call discover_databases", "loose": 1}
{"id": "dbh-readonly", "area": "databases", "request": "Make this database read-only so I can't change it by accident.", "predicate": "::scidb::db::get readonly? @MAIN@", "actions": ["menu.db.readonly", "run_action"], "gold": "gold_run menu.db.readonly"}
{"id": "dbh-open-load", "area": "databases", "request": "Open @CLUB@ and load its third game.", "predicate": "expr {[ev_db_is @CLUB@] && [ev_gameno] == 3}", "actions": ["open_database", "open_game", "menu.file.open", "menu.game.load_number", "run_action"], "gold": "gold_call open_database [list path @CLUB@]; gold_call open_game {number 3}", "multi": 1}
{"id": "dbh-close-tab", "area": "databases", "request": "Close the club database and then show me the database tab.", "predicate": "expr {![ev_open @CLUB@] && [ev_tab] eq {database}}", "actions": ["menu.file.close", "switch_tab", "run_action"], "gold": "gold_run menu.file.close; gold_call switch_tab {tab database}", "setup": "::application::database::openBase .application @CLUB@ yes -encoding $::encoding::autoEncoding -switchToBase 1", "multi": 1}
{"id": "gameh-load100", "area": "games", "request": "Load game 100.", "predicate": "expr {[ev_gameno] == 100}", "actions": ["open_game", "menu.game.load_number", "run_action"], "gold": "gold_call open_game {number 100}"}
{"id": "gameh-first", "area": "games", "request": "Go to the first game of the database.", "predicate": "expr {[ev_gameno] == 1}", "actions": ["open_game", "game-first", "run_action"], "gold": "gold_run game-first"}
{"id": "gameh-prev", "area": "games", "request": "show me the previous game", "predicate": "expr {[ev_gameno] == 9}", "actions": ["open_game", "game-prev", "run_action"], "gold": "gold_run game-prev", "loose": 1}
{"id": "gameh-new", "area": "games", "request": "I want a blank game so I can enter moves.", "predicate": "expr {[ev_moves] == 0 && [ev_tag White] in {{} ?}}", "actions": ["new_game", "game-new", "run_action"], "gold": "gold_call new_game"}
{"id": "gameh-truncate", "area": "games", "request": "Delete all the moves after this point in the game.", "predicate": "expr {[ev_gameno] == 10 && [ev_ply] == 12 && [ev_moves] == 12}", "actions": ["c2.strip.truncate", "run_action"], "gold": "gold_run c2.strip.truncate"}
{"id": "gameh-goodmove", "area": "games", "request": "Mark the move just played as a good move.", "predicate": "expr {[ev_gameno] == 10 && [lsearch -regexp [::scidb::game::query annotation] {^(\\$)?1$|^!$}] >= 0}", "actions": ["annot-good-move", "run_action"], "gold": "gold_run annot-good-move"}
{"id": "gameh-andreikin", "area": "games", "request": "andreikins latest game on the board pls", "predicate": "expr {[ev_player_in_game Andreikin] && [ev_gameno] > 0}", "actions": ["open_game", "search_games", "show_search", "run_action"], "gold": "gold_call open_game {player Andreikin}", "loose": 1}
{"id": "gameh-caruana-first", "area": "games", "request": "Find Caruana's games and load the first one in the list.", "predicate": "expr {[ev_player_in_game Caruana] && [ev_gameno] > 0}", "actions": ["search_games", "show_search", "open_game", "run_action"], "gold": "gold_call search_games {player Caruana}; gold_call show_search; gold_call open_game [list number [expr {[::scidb::db::get gameNumber [ev_db] Normal 0 0] + 1}]]", "multi": 1}
{"id": "gameh-load-end", "area": "games", "request": "Open game 12 and jump to its final position.", "predicate": "expr {[ev_gameno] == 12 && [ev_ply] == [ev_moves] && [ev_moves] > 0}", "actions": ["open_game", "nav-end", "run_action"], "gold": "gold_call open_game {number 12}; gold_run nav-end", "multi": 1}
{"id": "gameh-load-truncate", "area": "games", "request": "Load game 20, go to White's 10th move and cut off everything after it.", "predicate": "expr {[ev_gameno] == 20 && [ev_moves] == 19 && [ev_ply] == 19}", "actions": ["open_game", "c2.strip.truncate", "run_action"], "gold": "gold_call open_game {number 20 move 10}; ::scidb::game::go key [lindex [::scidb::game::query mainline] 18 0]; gold_run c2.strip.truncate", "multi": 1}
{"id": "gameh-new-moves", "area": "games", "request": "Start a new game and play 1.e4 c5 on it.", "predicate": "expr {[ev_moves] == 2 && [lrange [ev_fen] 0 1] eq {rnbqkbnr/pp1ppppp/8/2p5/4P3/8/PPPP1PPP/RNBQKBNR w}}", "actions": ["new_game", "set_position", "game-new", "run_action"], "gold": "gold_call new_game; gold_call set_position {moves {1.e4 c5}}", "multi": 1}
{"id": "boardh-moves", "area": "board", "request": "Set up the position after 1.d4 Nf6 2.c4 e6 3.Nc3 Bb4.", "predicate": "expr {[lindex [ev_fen] 0] eq {rnbqk2r/pppp1ppp/4pn2/8/1bPP4/2N5/PP2PPPP/R1BQKBNR}}", "actions": ["set_position", "run_action"], "gold": "gold_call set_position {moves {1.d4 Nf6 2.c4 e6 3.Nc3 Bb4}}"}
{"id": "boardh-fen", "area": "board", "request": "Put this position on the board: 8/8/8/4k3/8/8/4P3/4K3 w - - 0 1", "predicate": "expr {[lindex [ev_fen] 0] eq {8/8/8/4k3/8/8/4P3/4K3} && [lindex [ev_fen] 1] eq {w}}", "actions": ["set_position", "menu.board.setup", "run_action"], "gold": "gold_call set_position {fen {8/8/8/4k3/8/8/4P3/4K3 w - - 0 1}}"}
{"id": "boardh-flip", "area": "board", "request": "turn the board around", "predicate": "ev_flipped", "actions": ["board-flip", "c1.flip_board", "run_action"], "gold": "gold_run board-flip", "loose": 1}
{"id": "boardh-end", "area": "board", "request": "Go to the end of the game.", "predicate": "expr {[ev_gameno] == 10 && [ev_ply] == [ev_moves]}", "actions": ["nav-end", "run_action"], "gold": "gold_run nav-end"}
{"id": "boardh-start", "area": "board", "request": "Back to the start of the game, please.", "predicate": "expr {[ev_gameno] == 10 && [ev_ply] == 0}", "actions": ["nav-start", "run_action"], "gold": "gold_run nav-start"}
{"id": "boardh-back", "area": "board", "request": "Take back one move.", "predicate": "expr {[ev_gameno] == 10 && [ev_ply] == 11}", "actions": ["nav-back", "run_action"], "gold": "gold_run nav-back"}
{"id": "boardh-black8", "area": "board", "request": "Jump to Black's 8th move in this game.", "predicate": "expr {[ev_gameno] == 10 && [ev_ply] == 16}", "actions": ["open_game", "run_action"], "gold": "::scidb::game::go key [lindex [::scidb::game::query mainline] 15 0]"}
{"id": "boardh-flip-end", "area": "board", "request": "Flip the board and go to the final position.", "predicate": "expr {[ev_flipped] && [ev_ply] == [ev_moves] && [ev_gameno] == 10}", "actions": ["board-flip", "nav-end", "run_action"], "gold": "gold_run board-flip; gold_run nav-end", "multi": 1}
{"id": "boardh-load-flip", "area": "board", "request": "Load game 50 and look at it from Black's side.", "predicate": "expr {[ev_flipped] && [ev_gameno] == 50}", "actions": ["open_game", "board-flip", "run_action"], "gold": "gold_call open_game {number 50}; gold_run board-flip", "multi": 1}
{"id": "searchh-player", "area": "search", "request": "Show only Bortnyk's games in the game list.", "predicate": "ev_filter_all Player *Bortnyk*", "actions": ["search_games", "show_search", "run_action"], "gold": "gold_call search_games {player Bortnyk}; gold_call show_search"}
{"id": "searchh-eco", "area": "search", "request": "List the games that opened with ECO code B12.", "predicate": "ev_filter_all ECO B12", "actions": ["search_games", "show_search", "run_action"], "gold": "gold_call search_games {eco B12}; gold_call show_search"}
{"id": "searchh-event", "area": "search", "request": "Filter the game list to the Atyrau Chess Masters Open.", "predicate": "ev_filter_all Event *Atyrau*", "actions": ["search_games", "show_search", "run_action"], "gold": "gold_call search_games {event Atyrau}; gold_call show_search"}
{"id": "searchh-clear", "area": "search", "request": "Show all the games again.", "predicate": "expr {[ev_search_count] == [ev_total_games]}", "actions": ["clear_search", "run_action"], "gold": "gold_call clear_search", "setup": "gold_call search_games {player Caruana}; gold_call show_search"}
{"id": "searchh-sarana-black", "area": "search", "request": "Show the games Sarana won with Black.", "predicate": "expr {[ev_filter_all Black *Sarana*] && [ev_filter_all Result 0-1]}", "actions": ["search_games", "show_search", "run_action"], "gold": "gold_call search_games {player Sarana color black result win}; gold_call show_search"}
{"id": "searchh-loose", "area": "search", "request": "maghsoodloo games??", "predicate": "ev_filter_all Player *Maghsoodloo*", "actions": ["search_games", "show_search", "run_action"], "gold": "gold_call search_games {player Maghsoodloo}; gold_call show_search", "loose": 1}
{"id": "searchh-material", "area": "search", "request": "Open the material search.", "predicate": "ev_opened material", "actions": ["open_search", "menu.db.search.material", "run_action"], "gold": "gold_run menu.db.search.material"}
{"id": "searchh-dupes", "area": "search", "request": "Look for duplicate games in this database.", "predicate": "ev_opened {duplic|maintenance}", "actions": ["open_view", "menu.db.search.duplicates", "maintenance_report", "run_action"], "gold": "gold_run menu.db.search.duplicates"}
{"id": "searchh-tab-event", "area": "search", "request": "Go to the database tab and show only the games from the 41st ECC Open.", "predicate": "expr {[ev_tab] eq {database} && [ev_filter_all Event *ECC*]}", "actions": ["switch_tab", "search_games", "show_search", "run_action"], "gold": "gold_call search_games {event {41st ECC Open}}; gold_call show_search; gold_call switch_tab {tab database}", "multi": 1}
{"id": "searchh-event-load", "area": "search", "request": "Show the games from the FISU World Uni Classical and open the first one.", "predicate": "expr {[ev_filter_all Event *Classical*] && [string match *Classical* [ev_tag Event]] && [ev_gameno] > 0}", "actions": ["search_games", "show_search", "open_game", "run_action"], "gold": "gold_call search_games {event {FISU World Uni Classical}}; gold_call show_search; gold_call open_game [list number [expr {[::scidb::db::get gameNumber [ev_db] Normal 0 0] + 1}]]", "multi": 1}
{"id": "treeh-show", "area": "trees", "request": "Show the opening tree.", "predicate": "ev_pane_shown tree", "actions": ["menu.view.panes.tree", "pane", "run_action"], "gold": "gold_run menu.view.panes.tree", "setup": "ev_pane_hide tree"}
{"id": "treeh-explorer", "area": "trees", "request": "Open the opening explorer.", "predicate": "ev_pane_shown explorer", "actions": ["menu.view.panes.explorer", "menu.analysis.explorer", "pane", "run_action"], "gold": "gold_run menu.view.panes.explorer", "setup": "ev_pane_hide explorer"}
{"id": "treeh-float", "area": "trees", "request": "Put the tree in a separate window.", "predicate": "ev_floating tree", "actions": ["pane", "run_action"], "gold": "gold_call pane {action undock pane tree}", "setup": "ev_pane_show tree"}
{"id": "treeh-report", "area": "trees", "request": "Make an opening report for this position.", "predicate": "ev_opened report|opening", "actions": ["open_view", "menu.db.reports.opening", "run_action"], "gold": "gold_run menu.db.reports.opening"}
{"id": "treeh-eco", "area": "trees", "request": "Show ECO statistics for this database.", "predicate": "ev_opened {eco|opening prep}", "actions": ["open_view", "menu.db.reports.eco", "run_action"], "gold": "gold_run menu.db.reports.eco"}
{"id": "treeh-moves-tree", "area": "trees", "request": "Set up 1.e4 e6 and show me the opening tree for it.", "predicate": "expr {[lindex [ev_fen] 0] eq {rnbqkbnr/pppp1ppp/4p3/8/4P3/8/PPPP1PPP/RNBQKBNR} && [ev_pane_shown tree]}", "actions": ["set_position", "menu.view.panes.tree", "pane", "run_action"], "gold": "gold_call set_position {moves {1.e4 e6}}; gold_run menu.view.panes.tree", "setup": "ev_pane_hide tree", "multi": 1}
{"id": "treeh-both", "area": "trees", "request": "show the tree and the explorer", "predicate": "expr {[ev_pane_shown tree] && [ev_pane_shown explorer]}", "actions": ["menu.view.panes.tree", "menu.view.panes.explorer", "pane", "run_action"], "gold": "gold_run menu.view.panes.tree; gold_run menu.view.panes.explorer", "setup": "ev_pane_hide tree; ev_pane_hide explorer", "multi": 1, "loose": 1}
{"id": "engh-start", "area": "engines", "request": "Analyse this position with the engine.", "predicate": "expr {[ev_engine_running] > 0}", "actions": ["start_engine", "menu.analysis.engine_toggle", "menu.analysis.analyze", "run_action"], "gold": "gold_call start_engine"}
{"id": "engh-stop", "area": "engines", "request": "turn the engine off", "predicate": "expr {[ev_engine_running] == 0}", "actions": ["stop_engine", "menu.analysis.engine_toggle", "run_action"], "gold": "gold_call stop_engine", "setup": "::application::assistant::RunTool start_engine {}", "loose": 1}
{"id": "engh-lines", "area": "engines", "request": "Start the engine and show three lines.", "predicate": "expr {[ev_engine_running] > 0 && [ev_engine_lines] == 3}", "actions": ["start_engine", "run_action"], "gold": "gold_call start_engine {lines 3}"}
{"id": "engh-pos-start", "area": "engines", "request": "Set up 1.e4 e5 2.Nf3 Nc6 3.Bb5 and start the engine on it.", "predicate": "expr {[lindex [ev_fen] 0] eq {r1bqkbnr/pppp1ppp/2n5/1B2p3/4P3/5N2/PPPP1PPP/RNBQK2R} && [ev_engine_running] > 0}", "actions": ["set_position", "start_engine", "run_action"], "gold": "gold_call set_position {moves {1.e4 e5 2.Nf3 Nc6 3.Bb5}}; gold_call start_engine", "multi": 1}
{"id": "engh-console", "area": "engines", "request": "Open the engine console.", "predicate": "ev_opened console", "actions": ["menu.tools.engine_console", "run_action"], "gold": "gold_run menu.tools.engine_console"}
{"id": "engh-prefs", "area": "engines", "request": "Open the engine settings.", "predicate": "ev_opened engine", "actions": ["menu.edit.preferences.engines", "menu.analysis.engines", "engine_options", "run_action"], "gold": "gold_run menu.analysis.engines"}
{"id": "engh-pane", "area": "engines", "request": "Put the engine analysis pane in its own window.", "predicate": "ev_floating analysis", "actions": ["pane", "run_action"], "gold": "gold_call pane {action undock pane analysis}"}
{"id": "engh-flip-start", "area": "engines", "request": "Flip the board and start analysing.", "predicate": "expr {[ev_flipped] && [ev_engine_running] > 0}", "actions": ["board-flip", "start_engine", "run_action"], "gold": "gold_run board-flip; gold_call start_engine", "multi": 1}
{"id": "engh-load-start", "area": "engines", "request": "Load Caruana's most recent game and start the engine.", "predicate": "expr {[ev_player_in_game Caruana] && [ev_engine_running] > 0}", "actions": ["open_game", "start_engine", "run_action"], "gold": "gold_call open_game {player Caruana}; gold_call start_engine", "multi": 1}
{"id": "playh-engine", "area": "play", "request": "I'd like to play a game against the computer.", "predicate": "ev_opened play|engine", "actions": ["menu.training.play_engine", "run_action"], "gold": "gold_run menu.training.play_engine"}
{"id": "playh-tactics", "area": "play", "request": "Open the tactics trainer.", "predicate": "ev_opened tactic", "actions": ["menu.training.tactics", "run_action"], "gold": "gold_run menu.training.tactics"}
{"id": "playh-endgame", "area": "play", "request": "Let me practise some endgames.", "predicate": "ev_opened endgame", "actions": ["menu.training.endgame", "run_action"], "gold": "gold_run menu.training.endgame"}
{"id": "playh-repertoire", "area": "play", "request": "Train my opening repertoire.", "predicate": "ev_opened repertoire", "actions": ["menu.training.repertoire", "run_action"], "gold": "gold_run menu.training.repertoire"}
{"id": "playh-match", "area": "play", "request": "Set up a match between two engines.", "predicate": "ev_opened match", "actions": ["menu.training.engine_match", "run_action"], "gold": "gold_run menu.training.engine_match"}
{"id": "playh-corr", "area": "play", "request": "show my correspondence games", "predicate": "ev_opened correspond", "actions": ["menu.tools.correspondence", "correspondence_games", "run_action"], "gold": "gold_run menu.tools.correspondence", "loose": 1}
{"id": "playerh-card", "area": "players", "request": "Show the player card for Caruana.", "predicate": "ev_opened card|Caruana", "actions": ["open_view", "menu.tools.player_card", "run_action"], "gold": "gold_call open_view {kind player_card name Caruana}"}
{"id": "playerh-dict", "area": "players", "request": "Open the player dictionary.", "predicate": "ev_opened dictionary|player", "actions": ["menu.tools.player_dictionary", "run_action"], "gold": "gold_run menu.tools.player_dictionary"}
{"id": "playerh-me", "area": "players", "request": "My name is Michael Thomas, please remember that.", "predicate": "expr {[string match -nocase *thomas* [ev_me]] && [string match -nocase *michael* [ev_me]]}", "actions": ["remember_me", "run_action"], "gold": "gold_call remember_me {name {Thomas, Michael}}", "setup": "set ::application::ai::Settings(me) {}"}
{"id": "playerh-xiong", "area": "players", "request": "Show Xiong's games with White and open his player card.", "predicate": "expr {[ev_filter_all White *Xiong*] && [ev_opened card|Xiong]}", "actions": ["search_games", "show_search", "open_view", "menu.tools.player_card", "run_action"], "gold": "gold_call search_games {player Xiong color white}; gold_call show_search; gold_call open_view {kind player_card name Xiong}", "multi": 1}
{"id": "playerh-private", "area": "players", "request": "Let me edit my own private player card.", "predicate": "ev_opened player", "actions": ["menu.edit.preferences.player", "run_action"], "gold": "gold_run menu.edit.preferences.player"}
{"id": "playerh-brief", "area": "players", "request": "Open the opponent brief.", "predicate": "ev_opened brief", "actions": ["menu.training.brief", "opponent_brief", "run_action"], "gold": "gold_run menu.training.brief"}
{"id": "playerh-load-card", "area": "players", "request": "whos pakleza? load one of his games and show his card", "predicate": "expr {[ev_player_in_game Pakleza] && [ev_opened card|Pakleza]}", "actions": ["open_game", "open_view", "search_games", "show_search", "menu.tools.player_card", "run_action"], "gold": "gold_call open_game {player Pakleza}; gold_call open_view {kind player_card name Pakleza}", "multi": 1, "loose": 1}
{"id": "exph-pgn", "area": "export", "request": "Export the database as PGN.", "predicate": "ev_opened export", "actions": ["export_database", "menu.file.export.pgn", "run_action"], "gold": "gold_run menu.file.export.pgn"}
{"id": "exph-html", "area": "export", "request": "Make an HTML report of the database.", "predicate": "ev_opened export|html", "actions": ["export_database", "menu.file.export.html", "run_action"], "gold": "gold_run menu.file.export.html"}
{"id": "exph-filtered", "area": "export", "request": "Filter to Caruana's games and export just those.", "predicate": "expr {[ev_filter_all Player *Caruana*] && [ev_opened export]}", "actions": ["search_games", "show_search", "export_database", "menu.file.export.pgn", "run_action"], "gold": "gold_call search_games {player Caruana}; gold_call show_search; gold_run menu.file.export.pgn", "multi": 1}
{"id": "exph-archive", "area": "export", "request": "Create an archive of this database.", "predicate": "ev_opened archive", "actions": ["menu.file.archive_create", "menu.file.export.archive", "run_action"], "gold": "gold_run menu.file.archive_create"}
{"id": "exph-pgnopts", "area": "export", "request": "Open the PGN export options.", "predicate": "ev_opened pgn|export|option", "actions": ["menu.edit.preferences.pgn", "run_action"], "gold": "gold_run menu.edit.preferences.pgn"}
{"id": "exph-game", "area": "export", "request": "Load game 30 and export it.", "predicate": "expr {[ev_gameno] == 30 && [ev_opened export]}", "actions": ["open_game", "game-export", "export_database", "run_action"], "gold": "gold_call open_game {number 30}; gold_run game-export", "multi": 1}
{"id": "imph-pgn", "area": "media", "request": "Import @PGN@ into this database.", "predicate": "expr {[ev_games_in @MAIN@] == $::EV(n) + 2}", "actions": ["import_games", "menu.file.import.pgn", "run_action"], "gold": "gold_call import_games [list files [list @PGN@]]", "setup": "set ::EV(n) [ev_games_in @MAIN@]"}
{"id": "imph-club", "area": "media", "request": "Open @CLUB@ and import @PGN@ into it.", "predicate": "expr {[ev_db_is @CLUB@] && [ev_games_in @CLUB@] == $::EV(c) + 2}", "actions": ["open_database", "import_games", "menu.file.open", "menu.file.import.pgn", "run_action"], "gold": "gold_call open_database [list path @CLUB@]; gold_call import_games [list files [list @PGN@]]", "setup": "::application::database::openBase .application @CLUB@ yes -encoding $::encoding::autoEncoding -switchToBase 1; set ::EV(c) [ev_games_in @CLUB@]; ::application::database::closeBase .application @CLUB@", "multi": 1}
{"id": "imph-import-filter", "area": "media", "request": "Import @PGN@ and then show only the games from the Evaluation Import event.", "predicate": "expr {[ev_games_in @MAIN@] == $::EV(n) + 2 && [ev_filter_all Event {Evaluation Import}]}", "actions": ["import_games", "search_games", "show_search", "run_action"], "gold": "gold_call import_games [list files [list @PGN@]]; gold_call search_games {event {Evaluation Import}}; gold_call show_search", "setup": "set ::EV(n) [ev_games_in @MAIN@]", "multi": 1}
{"id": "mediah-pane", "area": "media", "request": "Show the media pane.", "predicate": "ev_pane_shown media", "actions": ["menu.view.panes.media", "pane", "run_action"], "gold": "gold_run menu.view.panes.media", "setup": "ev_pane_hide media"}
{"id": "mediah-stream", "area": "media", "request": "I want to watch a live stream.", "predicate": "ev_opened stream", "actions": ["open_stream", "run_action"], "gold": "gold_call run_action {id open_stream}"}
{"id": "mediah-download", "area": "media", "request": "Download games from the internet.", "predicate": "ev_opened download", "actions": ["menu.tools.download", "run_action"], "gold": "gold_run menu.tools.download"}
{"id": "mediah-import-dlg", "area": "media", "request": "Open the import dialog.", "predicate": "ev_opened import", "actions": ["menu.tools.import_games", "menu.file.import.pgn", "run_action"], "gold": "gold_run menu.tools.import_games"}
{"id": "layh-dbtab", "area": "layout", "request": "Show the database tab.", "predicate": "expr {[ev_tab] eq {database}}", "actions": ["switch_tab", "run_action"], "gold": "gold_call switch_tab {tab database}"}
{"id": "layh-board", "area": "layout", "request": "go back to the board", "predicate": "expr {[ev_tab] eq {board}}", "actions": ["switch_tab", "run_action"], "gold": "gold_call switch_tab {tab board}", "setup": "::application::switchTab database", "loose": 1}
{"id": "layh-full", "area": "layout", "request": "Make the window fullscreen.", "predicate": "ev_fullscreen", "actions": ["app-fullscreen", "run_action"], "gold": "gold_run app-fullscreen"}
{"id": "layh-unfull", "area": "layout", "request": "Leave full screen mode.", "predicate": "expr {![ev_fullscreen]}", "actions": ["app-fullscreen", "run_action"], "gold": "gold_run app-fullscreen", "setup": "::menu::setFullscreen 1"}
{"id": "layh-font", "area": "layout", "request": "make the text bigger plz", "predicate": "expr {[ev_fontsize] > $::EV(f)}", "actions": ["menu.view.font_inc", "run_action"], "gold": "gold_run menu.view.font_inc", "setup": "set ::EV(f) [ev_fontsize]", "loose": 1}
{"id": "layh-keys", "area": "layout", "request": "Open the keyboard shortcut settings.", "predicate": "ev_opened key", "actions": ["menu.edit.keyboard", "run_action"], "gold": "gold_run menu.edit.keyboard"}
{"id": "layh-maxboard", "area": "layout", "request": "Maximise the board.", "predicate": "ev_zoomed board", "actions": ["pane", "c9.maximise", "run_action"], "gold": "gold_call pane {action maximise pane board}"}
{"id": "layh-asstprefs", "area": "layout", "request": "Open the assistant preferences.", "predicate": "ev_opened assist|prefer", "actions": ["app.preferences.assistant", "run_action"], "gold": "gold_run app.preferences.assistant"}
{"id": "layh-tab-full", "area": "layout", "request": "Switch to the database tab and go full screen.", "predicate": "expr {[ev_tab] eq {database} && [ev_fullscreen]}", "actions": ["switch_tab", "app-fullscreen", "run_action"], "gold": "gold_call switch_tab {tab database}; gold_run app-fullscreen", "multi": 1}
{"id": "layh-float-dock", "area": "layout", "request": "Dock the tree window back into the main window and maximise the board.", "predicate": "expr {[ev_pane_shown tree] && ![ev_floating tree] && [ev_zoomed board]}", "actions": ["pane", "run_action"], "gold": "gold_call pane {action dock pane tree}; gold_call pane {action maximise pane board}", "setup": "ev_pane_show tree; ::application::assistant::DoPane undock tree", "multi": 1}
{"id": "layh-hide-tree", "area": "layout", "request": "hide teh tree pane", "predicate": "expr {![ev_pane_shown tree]}", "actions": ["menu.view.panes.tree", "pane", "run_action"], "gold": "gold_run menu.view.panes.tree", "setup": "ev_pane_show tree", "loose": 1}
