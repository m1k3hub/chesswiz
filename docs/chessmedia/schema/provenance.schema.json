{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chesswiz.org/schemas/chessmedia/1.1/provenance.schema.json",
  "title": "ChessMedia 1.1 Import Provenance",
  "description": "Audit and confidence record for legacy lesson conversions, marking all inferred values without fabricated precision.",
  "type": "object",
  "required": [
    "schema_version",
    "importer",
    "confidence",
    "clock_source",
    "clock_mapping_status",
    "sources",
    "inferred_summary",
    "warnings"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "1.1" },
    "importer": {
      "type": "object",
      "required": ["name", "version"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" }
      }
    },
    "confidence": {
      "enum": ["high", "medium", "low", "unsynchronized_media_only"]
    },
    "clock_source": {
      "enum": ["unresolved_dual", "sidecar_txt", "wmv_pts", "checkpoint_type37", "none"]
    },
    "clock_mapping_status": {
      "enum": ["unresolved", "verified_part_c", "not_applicable"]
    },
    "clock_drift_stats": {
      "type": "object",
      "additionalProperties": true
    },
    "source_clock_timestamps": {
      "type": "object",
      "additionalProperties": true
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["role", "filename", "bytes", "sha256"],
        "additionalProperties": false,
        "properties": {
          "role": { "enum": ["video", "sidecar_txt", "pgn", "cms_index"] },
          "filename": { "type": "string" },
          "bytes": { "type": "integer", "minimum": 0 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "inferred_summary": {
      "type": "object",
      "required": [
        "inferred_start_fen",
        "inferred_clock_choice",
        "inferred_promotions",
        "inferred_overlay_colors",
        "unresolved_goto_count",
        "total_goto_count"
      ],
      "additionalProperties": true,
      "properties": {
        "inferred_start_fen": { "type": "boolean" },
        "start_fen_source": { "type": "string" },
        "inferred_clock_choice": { "type": "boolean" },
        "inferred_promotions": { "type": "integer", "minimum": 0 },
        "inferred_overlay_colors": { "type": "integer", "minimum": 0 },
        "unresolved_goto_count": { "type": "integer", "minimum": 0 },
        "total_goto_count": { "type": "integer", "minimum": 0 }
      }
    },
    "incomplete_intervals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["start_ms", "end_ms", "reason"],
        "additionalProperties": false,
        "properties": {
          "start_ms": { "type": "integer", "minimum": 0 },
          "end_ms": { "type": "integer", "minimum": 0 },
          "reason": { "type": "string" }
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
