{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chesswiz.org/schemas/chessmedia/1.1/manifest.schema.json",
  "title": "ChessMedia 1.1 Manifest",
  "description": "Package manifest for a ChessMedia 1.1 multimedia chess lesson.",
  "type": "object",
  "required": [
    "format",
    "version",
    "id",
    "title",
    "required_features",
    "boards",
    "games",
    "assets",
    "timelines",
    "links",
    "gallery_order",
    "primary",
    "members"
  ],
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "chessmedia"
    },
    "version": {
      "type": "object",
      "required": ["major", "minor"],
      "additionalProperties": false,
      "properties": {
        "major": { "const": 1 },
        "minor": { "type": "integer", "minimum": 1 }
      }
    },
    "id": { "$ref": "#/$defs/id" },
    "title": { "type": "string", "minLength": 1 },
    "language": { "type": "string", "minLength": 2, "maxLength": 35 },
    "required_features": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "boards": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "title": { "type": "string" }
        }
      }
    },
    "games": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "path", "fingerprint"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "path": { "$ref": "#/$defs/relpath" },
          "title": { "type": "string" },
          "fingerprint": { "$ref": "#/$defs/fingerprint" }
        }
      }
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/asset" }
    },
    "timelines": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "path", "clock_asset_id"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "path": { "$ref": "#/$defs/relpath" },
          "clock_asset_id": { "$ref": "#/$defs/id" }
        }
      }
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["game_id", "asset_id"],
        "additionalProperties": false,
        "properties": {
          "game_id": { "$ref": "#/$defs/id" },
          "asset_id": { "$ref": "#/$defs/id" },
          "timeline_id": { "$ref": "#/$defs/id" },
          "role": {
            "enum": [
              "primary",
              "alternate-stream",
              "interactive-clip",
              "commentary",
              "supplemental"
            ]
          }
        }
      }
    },
    "gallery_order": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/id" },
      "uniqueItems": true
    },
    "primary": {
      "type": "object",
      "required": ["asset_id"],
      "additionalProperties": false,
      "properties": {
        "timeline_id": { "$ref": "#/$defs/id" },
        "asset_id": { "$ref": "#/$defs/id" }
      }
    },
    "interactive_triggers": {
      "type": "array",
      "items": { "$ref": "#/$defs/trigger" }
    },
    "provenance": {
      "type": "object",
      "required": ["path"],
      "additionalProperties": false,
      "properties": {
        "path": { "$ref": "#/$defs/relpath" }
      }
    },
    "members": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "bytes", "sha256"],
        "additionalProperties": false,
        "properties": {
          "path": { "$ref": "#/$defs/relpath" },
          "bytes": { "type": "integer", "minimum": 0 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "extensions": {
      "type": "object"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "relpath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*//)(?!.*(^|/)\\.\\.?($|/))[A-Za-z0-9._ /+-]+$"
    },
    "ms_nonneg": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "ms_signed": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "square": {
      "type": "string",
      "pattern": "^[a-h][1-8]$"
    },
    "fingerprint": {
      "type": "object",
      "required": ["header_hash", "move_hash", "combined"],
      "additionalProperties": false,
      "properties": {
        "header_hash": { "type": "string", "pattern": "^[0-9a-f]{16}$" },
        "move_hash": { "type": "string", "pattern": "^[0-9a-f]{16}$" },
        "combined": { "type": "string", "pattern": "^[0-9a-f]{16}:[0-9a-f]{16}$" }
      }
    },
    "asset": {
      "oneOf": [
        {
          "type": "object",
          "required": ["id", "kind", "path", "media_type"],
          "additionalProperties": false,
          "properties": {
            "id": { "$ref": "#/$defs/id" },
            "kind": { "const": "file" },
            "path": { "$ref": "#/$defs/relpath" },
            "media_type": { "type": "string", "minLength": 3 },
            "duration_ms": { "$ref": "#/$defs/ms_nonneg" },
            "offset_ms": { "$ref": "#/$defs/ms_signed" },
            "clock_track": { "enum": ["presentation", "audio", "video"] },
            "title": { "type": "string" },
            "language": { "type": "string" }
          }
        },
        {
          "type": "object",
          "required": ["id", "kind", "uri", "media_type", "live", "duration_ms"],
          "additionalProperties": false,
          "properties": {
            "id": { "$ref": "#/$defs/id" },
            "kind": { "const": "stream" },
            "uri": { "type": "string", "pattern": "^https?://.+" },
            "fallback_path": { "$ref": "#/$defs/relpath" },
            "media_type": { "type": "string", "minLength": 3 },
            "duration_ms": { "$ref": "#/$defs/ms_nonneg" },
            "offset_ms": { "$ref": "#/$defs/ms_signed" },
            "clock_track": { "enum": ["presentation", "audio", "video"] },
            "live": { "const": false },
            "title": { "type": "string" },
            "language": { "type": "string" }
          }
        },
        {
          "type": "object",
          "required": ["id", "kind", "uri", "media_type", "live"],
          "additionalProperties": false,
          "properties": {
            "id": { "$ref": "#/$defs/id" },
            "kind": { "const": "stream" },
            "uri": { "type": "string", "pattern": "^https?://.+" },
            "fallback_path": { "$ref": "#/$defs/relpath" },
            "media_type": { "type": "string", "minLength": 3 },
            "duration_ms": { "$ref": "#/$defs/ms_nonneg" },
            "offset_ms": { "$ref": "#/$defs/ms_signed" },
            "clock_track": { "enum": ["presentation", "audio", "video"] },
            "live": { "const": true },
            "title": { "type": "string" },
            "language": { "type": "string" }
          }
        }
      ]
    },
    "branch": {
      "oneOf": [
        {
          "type": "object",
          "required": ["id", "uci", "role", "asset_id"],
          "additionalProperties": false,
          "properties": {
            "id": { "$ref": "#/$defs/id" },
            "uci": { "type": "string", "pattern": "^[a-h][1-8][a-h][1-8][qrbn]?$" },
            "san": { "type": "string" },
            "role": { "enum": ["primary", "alternative"] },
            "asset_id": { "$ref": "#/$defs/id" },
            "timeline_id": { "$ref": "#/$defs/id" },
            "overlay_arrow": {
              "type": "object",
              "required": ["from", "to"],
              "additionalProperties": false,
              "properties": {
                "from": { "$ref": "#/$defs/square" },
                "to": { "$ref": "#/$defs/square" }
              }
            }
          }
        },
        {
          "type": "object",
          "required": ["id", "uci", "role", "asset_id", "start_ms", "end_ms"],
          "additionalProperties": false,
          "properties": {
            "id": { "$ref": "#/$defs/id" },
            "uci": { "type": "string", "pattern": "^[a-h][1-8][a-h][1-8][qrbn]?$" },
            "san": { "type": "string" },
            "role": { "enum": ["primary", "alternative"] },
            "asset_id": { "$ref": "#/$defs/id" },
            "timeline_id": { "$ref": "#/$defs/id" },
            "start_ms": { "$ref": "#/$defs/ms_nonneg" },
            "end_ms": { "$ref": "#/$defs/ms_nonneg" },
            "overlay_arrow": {
              "type": "object",
              "required": ["from", "to"],
              "additionalProperties": false,
              "properties": {
                "from": { "$ref": "#/$defs/square" },
                "to": { "$ref": "#/$defs/square" }
              }
            }
          }
        }
      ]
    },
    "trigger": {
      "oneOf": [
        {
          "type": "object",
          "required": ["id", "fen", "kind", "asset_id"],
          "additionalProperties": false,
          "properties": {
            "id": { "$ref": "#/$defs/id" },
            "fen": { "type": "string", "minLength": 15 },
            "match_mode": { "enum": ["board_turn", "exact"] },
            "game_id": { "$ref": "#/$defs/id" },
            "node_id": { "$ref": "#/$defs/id" },
            "at_ms": { "$ref": "#/$defs/ms_nonneg" },
            "kind": { "const": "clip" },
            "asset_id": { "$ref": "#/$defs/id" },
            "timeline_id": { "$ref": "#/$defs/id" },
            "prompt": { "type": "string" },
            "branches": {
              "type": "array",
              "items": { "$ref": "#/$defs/branch" }
            }
          }
        },
        {
          "type": "object",
          "required": ["id", "fen", "kind", "asset_id", "start_ms", "end_ms"],
          "additionalProperties": false,
          "properties": {
            "id": { "$ref": "#/$defs/id" },
            "fen": { "type": "string", "minLength": 15 },
            "match_mode": { "enum": ["board_turn", "exact"] },
            "game_id": { "$ref": "#/$defs/id" },
            "node_id": { "$ref": "#/$defs/id" },
            "at_ms": { "$ref": "#/$defs/ms_nonneg" },
            "kind": { "const": "range" },
            "asset_id": { "$ref": "#/$defs/id" },
            "timeline_id": { "$ref": "#/$defs/id" },
            "start_ms": { "$ref": "#/$defs/ms_nonneg" },
            "end_ms": { "$ref": "#/$defs/ms_nonneg" },
            "prompt": { "type": "string" },
            "branches": {
              "type": "array",
              "items": { "$ref": "#/$defs/branch" }
            }
          }
        },
        {
          "type": "object",
          "required": ["id", "fen", "kind", "branches"],
          "additionalProperties": false,
          "properties": {
            "id": { "$ref": "#/$defs/id" },
            "fen": { "type": "string", "minLength": 15 },
            "match_mode": { "enum": ["board_turn", "exact"] },
            "game_id": { "$ref": "#/$defs/id" },
            "node_id": { "$ref": "#/$defs/id" },
            "at_ms": { "$ref": "#/$defs/ms_nonneg" },
            "kind": { "const": "branch_prompt" },
            "asset_id": { "$ref": "#/$defs/id" },
            "timeline_id": { "$ref": "#/$defs/id" },
            "prompt": { "type": "string" },
            "branches": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/branch" }
            }
          }
        }
      ]
    }
  }
}
